#!/usr/bin/env bash
#
# df_fishbowl — a Dwarf Fortress (df-ai) secure lock-screensaver.
#
# The fortress plays itself (BenLubar df-ai) in a detached tmux session and is
# displayed, live, on your monitors while the session is securely locked:
# the fortress on landscape outputs, df-ai's narration log on portrait ones.
# On unlock the fortress is quicksaved and torn down so it stops using CPU.
#
# Backends:
#   wayland — swaylock-plugin + windowtolayer + a Wayland terminal (tested on Sway)
#   x11     — xsecurelock + embedded X terminal (structured, UNTESTED)
#
# Usage: df_fishbowl <command>
#   lock         Start DF (if needed) and lock the session with the live view.
#   screensaver  Show DF fullscreen with NO lock (non-secure; dismiss with
#                Ctrl-C). The easiest way to try it out, and an option for
#                desktops where replacing the native locker isn't wanted.
#   start        Start DF in tmux without displaying it (for testing / warm-up).
#   stop         Quicksave and stop all df_fishbowl DF sessions.
#   classify     Print how each active output is classified (fortress|log).
#   cleanup      Delete saved fortresses older than SAVE_MAX_AGE_DAYS.
#   _render      Internal: invoked by the lock backend to draw per-output content.
set -euo pipefail

SELF="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)/$(basename "$0")"
ROOT="$(dirname "$(dirname "$SELF")")"   # .../screensaver

# --- Load configuration (shipped default, then user override) --------------
# shellcheck source=/dev/null
. "$ROOT/config/df_fishbowl.conf"
USER_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/df_fishbowl/config"
# shellcheck source=/dev/null
[ -f "$USER_CONF" ] && . "$USER_CONF"
# Derived defaults come last so they follow the user's overrides: deriving
# LOG_FILE in the shipped config bound it to the DEFAULT DF_HOME, and a user
# config that only moved DF_HOME left the log output tailing a file that did
# not exist.
LOG_FILE="${LOG_FILE:-$DF_HOME/df-ai.log}"

# --- Load shared helpers ---------------------------------------------------
# shellcheck source=/dev/null
. "$ROOT/lib/common.sh"

# --- Select and load the backend -------------------------------------------
detect_backend() {
	if [ -n "${DF_FISHBOWL_BACKEND:-}" ]; then
		printf '%s\n' "$DF_FISHBOWL_BACKEND"
	elif [ -n "${WAYLAND_DISPLAY:-}" ] || [ "${XDG_SESSION_TYPE:-}" = wayland ]; then
		printf 'wayland\n'
	elif [ -n "${DISPLAY:-}" ]; then
		printf 'x11\n'
	else
		printf 'wayland\n'
	fi
}
BACKEND="$(detect_backend)"
# shellcheck source=/dev/null
. "$ROOT/lib/backend-${BACKEND}.sh"

# --- Dispatch --------------------------------------------------------------
cmd="${1:-help}"
case "$cmd" in
help | -h | --help)
	# Bare invocation prints usage rather than locking — locking must be explicit.
	sed -n '2,${/^#/!q;p;}' "$SELF" | sed 's/^# \{0,1\}//'
	;;
lock)             backend_lock "${@:2}" ;;
screensaver)
	if declare -F backend_screensaver >/dev/null; then backend_screensaver
	else log_msg "screensaver mode is not implemented for the '$BACKEND' backend"; exit 3; fi
	;;
start | start-df) ensure_df_running "$(df_session_name)" ;;
stop)             stop_all_df ;;
classify)         classify_outputs ;;
cleanup)          cleanup_saves ;;
_render)          backend_render ;;
*)
	printf 'df_fishbowl: unknown command %q\n' "$cmd" >&2
	sed -n '2,${/^#/!q;p;}' "$SELF" | sed 's/^# \{0,1\}//' >&2
	exit 2
	;;
esac
